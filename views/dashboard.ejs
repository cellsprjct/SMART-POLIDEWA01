<!DOCTYPE html>
<html lang="id">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Dashboard Admin</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="/css/admin.css">

</head>

<body class="bg-light">

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow">

        <div class="container-fluid">

            <h3 class="text-white mb-0">

                <i class="bi bi-display"></i>

                DASHBOARD ADMIN SMART POLIDEWA

            </h3>

            <a href="/" class="btn btn-light">

                <i class="bi bi-tv"></i>

                Preview TV

            </a>

        </div>

    </nav>

    <div class="container mt-4">

        <!-- CARD STATISTIK -->
        <div class="row g-4">

            <div class="col-md-3">

                <div class="card shadow border-0">

                    <div class="card-body text-center">

                        <i class="bi bi-calendar-week text-primary fs-1"></i>

                        <h5 class="mt-2">Total Jadwal</h5>

                        <h2><%= typeof jadwal !== 'undefined' ? jadwal.length : 0 %></h2>

                    </div>

                </div>

            </div>

            <div class="col-md-3">

                <div class="card shadow border-0">

                    <div class="card-body text-center">

                        <i class="bi bi-person-video3 text-success fs-1"></i>

                        <h5 class="mt-2">Dosen</h5>

                        <h2>
                            <%= typeof jadwal !== 'undefined' ? [...new Set(jadwal.map(function(item) { return item.dosen; }))].length : 0 %>
                        </h2>

                    </div>

                </div>

            </div>

            <div class="col-md-3">

                <div class="card shadow border-0">

                    <div class="card-body text-center">

                        <i class="bi bi-building text-warning fs-1"></i>

                        <h5 class="mt-2">Ruangan</h5>

                        <h2>
                            <%= typeof jadwal !== 'undefined' ? [...new Set(jadwal.map(function(item) { return item.ruangan; }))].length : 0 %>
                        </h2>

                    </div>

                </div>

            </div>

            <div class="col-md-3">

                <div class="card shadow border-0">

                    <div class="card-body text-center">

                        <i class="bi bi-mortarboard text-info fs-1"></i>

                        <h5 class="mt-2">Program Studi</h5>

                        <h2>
                            <%= typeof jadwal !== 'undefined' ? [...new Set(jadwal.map(function(item) { return item.prodi; }))].length : 0 %>
                        </h2>

                    </div>

                </div>

            </div>

        </div>

        <!-- ===================================================== -->
        <!-- PANEL SLIDESHOW -->
        <!-- ===================================================== -->

        <div class="card shadow mt-4">

            <div class="card-header bg-primary text-white">

                <h4 class="mb-0">

                    <i class="bi bi-images"></i>

                    Manajemen Slideshow (Video/Foto)

                </h4>

            </div>

            <div class="card-body">

                <div class="upload-area" onclick="document.getElementById('fileInput').click()">

                    <i class="bi bi-cloud-upload"></i>

                    <h5 class="mt-2">Klik untuk Upload Gambar atau Video</h5>

                    <p class="text-muted mb-0">Format: JPG, PNG, GIF, WebP, MP4, WebM, OGG (Maks 50MB)</p>

                    <input type="file" id="fileInput" style="display:none" accept="image/*,video/*">

                </div>

                <div id="slideList" class="mt-3">

                    <% if(typeof slideshow !== 'undefined' && slideshow && slideshow.length > 0) { %>

                        <% for(var i = 0; i < slideshow.length; i++) { %>

                            <% var slide = slideshow[i]; %>

                            <div class="slide-item" data-id="<%= slide.id %>">

                                <div class="slide-preview">

                                    <% if(slide.type === 'video') { %>

                                        <video muted playsinline>
                                            <source src="<%= slide.url %>" type="<%= slide.mimetype %>">
                                        </video>

                                    <% } else { %>

                                        <img src="<%= slide.url %>" alt="<%= slide.title %>">

                                    <% } %>

                                </div>

                                <div class="slide-info">

                                    <div class="title"><%= slide.title || 'Slide' %></div>

                                    <div class="meta">
                                        <%= slide.type || 'image' %> • <%= (slide.size / 1024).toFixed(1) %> KB
                                    </div>

                                </div>

                                <div class="slide-actions">

                                    <button class="btn btn-sm btn-danger btn-hapus-slide" data-id="<%= slide.id %>">

                                        <i class="bi bi-trash"></i> Hapus

                                    </button>

                                </div>

                            </div>

                        <% } %>

                    <% } else { %>

                        <p class="text-muted text-center py-3">Belum ada slide. Upload gambar atau video untuk slideshow.</p>

                    <% } %>

                </div>

            </div>

        </div>

        <!-- TABEL -->
        <div class="card shadow mt-4">

            <div class="card-header bg-primary text-white">

                <div class="d-flex justify-content-between align-items-center">

                    <h4 class="mb-0">

                        <i class="bi bi-table"></i>

                        Data Jadwal Perkuliahan

                    </h4>

                    <a href="/admin/tambah" class="btn btn-success">

                        <i class="bi bi-plus-circle"></i>

                        Tambah Jadwal

                    </a>

                </div>

            </div>

            <div class="card-body">

                <div class="row mt-3 g-2">

                    <div class="col-md-3">

                        <select id="filterHari" class="form-select">

                            <option value="">📅 Semua Hari</option>

                            <option value="Senin">Senin</option>
                            <option value="Selasa">Selasa</option>
                            <option value="Rabu">Rabu</option>
                            <option value="Kamis">Kamis</option>
                            <option value="Jumat">Jumat</option>
                            <option value="Sabtu">Sabtu</option>
                            <option value="Minggu">Minggu</option>

                        </select>

                    </div>

                    <div class="col-md-3">

                        <select id="filterRuangan" class="form-select">

                            <option value="">🏫 Semua Ruangan</option>

                            <% if(typeof jadwal !== 'undefined' && jadwal.length > 0) { %>

                                <% var ruangList = [...new Set(jadwal.map(function(j) { return j.ruangan; }))]; %>

                                <% for(var r = 0; r < ruangList.length; r++) { %>

                                    <option value="<%= ruangList[r] %>">

                                        <%= ruangList[r] %>

                                    </option>

                                <% } %>

                            <% } %>

                        </select>

                    </div>

                    <div class="col-md-3">

                        <select id="filterProdi" class="form-select">

                            <option value="">🎓 Semua Prodi</option>

                            <% if(typeof jadwal !== 'undefined' && jadwal.length > 0) { %>

                                <% var prodiList = [...new Set(jadwal.map(function(j) { return j.prodi; }))]; %>

                                <% for(var p = 0; p < prodiList.length; p++) { %>

                                    <option value="<%= prodiList[p] %>">

                                        <%= prodiList[p] %>

                                    </option>

                                <% } %>

                            <% } %>

                        </select>

                    </div>

                    <div class="col-md-3">

                        <input type="text" id="searchMatkul" class="form-control" placeholder="🔍 Cari Mata Kuliah...">

                    </div>

                </div>

                <div class="table-responsive mt-3">

                    <table class="table table-bordered table-hover align-middle">

                        <thead class="table-primary text-center">

                            <tr>

                                <th>No</th>

                                <th>Hari</th>

                                <th>Jam</th>

                                <th>Mata Kuliah</th>

                                <th>Program Studi</th>

                                <th>Dosen</th>

                                <th>Ruangan</th>

                                <th>Status</th>

                                <th width="170">Aksi</th>

                            </tr>

                        </thead>

                        <tbody id="tbodyJadwal">

                            <% if(typeof jadwal !== 'undefined' && jadwal.length > 0) { %>

                                <% for(var i = 0; i < jadwal.length; i++) { %>

                                    <% var item = jadwal[i]; %>

                                    <tr class="jadwal-row" 
                                        data-hari="<%= item.hari %>" 
                                        data-ruangan="<%= item.ruangan %>" 
                                        data-prodi="<%= item.prodi || '' %>" 
                                        data-matkul="<%= item.matkul %>"
                                        data-jam="<%= item.jam %>"
                                        data-index="<%= item.indexAsli %>">

                                        <td class="text-center"><%= i + 1 %></td>

                                        <td class="hari"><%= item.hari %></td>

                                        <td><%= item.jamDisplay || item.jam %></td>

                                        <td class="matkul"><%= item.matkul %></td>

                                        <td class="prodi"><%= item.prodi || "-" %></td>

                                        <td><%= item.dosen %></td>

                                        <td class="ruangan"><%= item.ruangan %></td>

                                        <td class="text-center status-cell">

                                            <% if(item.status === "Berlangsung"){ %>

                                                <span class="badge bg-success">🟢 Berlangsung</span>

                                            <% } else if(item.status === "Belum Mulai"){ %>

                                                <span class="badge bg-warning text-dark">🟡 Belum Mulai</span>

                                            <% } else { %>

                                                <span class="badge bg-secondary">⚪ Selesai</span>

                                            <% } %>

                                        </td>

                                        <td class="text-center">

                                            <a href="/admin/edit/<%= item.indexAsli %>" class="btn btn-warning btn-sm">

                                                <i class="bi bi-pencil-square"></i>

                                            </a>

                                            <a href="/admin/hapus/<%= item.indexAsli %>" class="btn btn-danger btn-sm"
                                               onclick="return confirm('Yakin ingin menghapus jadwal ini?')">

                                                <i class="bi bi-trash"></i>

                                            </a>

                                        </td>

                                    </tr>

                                <% } %>

                            <% } else { %>

                                <tr>

                                    <td colspan="9" class="text-center">

                                        Belum ada jadwal.

                                    </td>

                                </tr>

                            <% } %>

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

    <!-- FOOTER -->
    <footer class="text-center mt-5 mb-3 text-secondary">

        <p>TEKNIK ELEKTRONIKA<p>
        <p>© 2026 POLITEKNIK DEWANTARA</p>

    </footer>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            
            // Upload file
            var fileInput = document.getElementById("fileInput");
            if (fileInput) {
                fileInput.addEventListener("change", function(e) {
                    var file = this.files[0];
                    if (!file) {
                        alert("Pilih file terlebih dahulu!");
                        return;
                    }

                    if (file.size > 50 * 1024 * 1024) {
                        alert("Ukuran file terlalu besar! Maksimal 50MB.");
                        this.value = "";
                        return;
                    }

                    var formData = new FormData();
                    formData.append("file", file);
                    formData.append("title", file.name);

                    fetch("/admin/api/slideshow", {
                        method: "POST",
                        body: formData
                    })
                    .then(function(response) {
                        return response.json();
                    })
                    .then(function(data) {
                        if (data.success) {
                            alert("✅ Slide berhasil diupload!");
                            location.reload();
                        } else {
                            alert("❌ Gagal upload: " + (data.error || "Unknown error"));
                        }
                    })
                    .catch(function(err) {
                        console.error("Error upload:", err);
                        alert("❌ Gagal upload file: " + err.message);
                    });

                    this.value = "";
                });
            }

            // Event listener untuk hapus slide
            document.addEventListener("click", function(e) {
                var target = e.target;
                var button = target.closest(".btn-hapus-slide");
                
                if (button) {
                    var id = button.getAttribute("data-id");
                    if (id) {
                        if (!confirm("Yakin ingin menghapus slide ini?")) {
                            return;
                        }

                        fetch("/admin/api/slideshow/" + id, {
                            method: "DELETE"
                        })
                        .then(function(response) {
                            return response.json();
                        })
                        .then(function(data) {
                            if (data.success) {
                                alert("✅ Slide berhasil dihapus!");
                                location.reload();
                            } else {
                                alert("❌ Gagal menghapus slide: " + (data.error || "Unknown error"));
                            }
                        })
                        .catch(function(err) {
                            console.error("Error hapus slide:", err);
                            alert("❌ Gagal menghapus slide: " + err.message);
                        });
                    }
                }
            });

            // ======================================
            // FUNGSI FILTER
            // ======================================

            function filterTabel() {
                var filterHari = document.getElementById("filterHari");
                var filterRuangan = document.getElementById("filterRuangan");
                var filterProdi = document.getElementById("filterProdi");
                var searchMatkul = document.getElementById("searchMatkul");

                var hari = filterHari ? filterHari.value.trim().toLowerCase() : "";
                var ruangan = filterRuangan ? filterRuangan.value.trim().toLowerCase() : "";
                var prodi = filterProdi ? filterProdi.value.trim().toLowerCase() : "";
                var keyword = searchMatkul ? searchMatkul.value.trim().toLowerCase() : "";

                var rows = document.querySelectorAll(".jadwal-row");
                var nomor = 1;

                rows.forEach(function(row) {
                    var dataHari = (row.getAttribute("data-hari") || "").toLowerCase();
                    var dataRuangan = (row.getAttribute("data-ruangan") || "").toLowerCase();
                    var dataProdi = (row.getAttribute("data-prodi") || "").toLowerCase();
                    var dataMatkul = (row.getAttribute("data-matkul") || "").toLowerCase();

                    var cocokHari = true;
                    var cocokRuangan = true;
                    var cocokProdi = true;
                    var cocokMatkul = true;

                    if (hari) cocokHari = dataHari === hari;
                    if (ruangan) cocokRuangan = dataRuangan === ruangan;
                    if (prodi) cocokProdi = dataProdi === prodi;
                    if (keyword) cocokMatkul = dataMatkul.includes(keyword);

                    if (cocokHari && cocokRuangan && cocokProdi && cocokMatkul) {
                        row.style.display = "";
                        var tdNo = row.querySelector("td:first-child");
                        if (tdNo) tdNo.textContent = nomor++;
                    } else {
                        row.style.display = "none";
                    }
                });
            }

            var filterHari = document.getElementById("filterHari");
            var filterRuangan = document.getElementById("filterRuangan");
            var filterProdi = document.getElementById("filterProdi");
            var searchMatkul = document.getElementById("searchMatkul");

            if (filterHari) filterHari.addEventListener("change", filterTabel);
            if (filterRuangan) filterRuangan.addEventListener("change", filterTabel);
            if (filterProdi) filterProdi.addEventListener("change", filterTabel);
            if (searchMatkul) searchMatkul.addEventListener("keyup", filterTabel);

            setTimeout(filterTabel, 100);
        });
    </script>

</body>

</html>