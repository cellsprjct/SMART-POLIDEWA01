<!DOCTYPE html>
<html lang="id">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Dashboard Admin</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="/css/admin.css">

</head>

<body class="bg-light">

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow">

        <div class="container-fluid">

            <h3 class="text-white mb-0">

                <i class="bi bi-display"></i>

                DASHBOARD ADMIN SMART POLIDEWA

            </h3>

            <a href="/" class="btn btn-light">

                <i class="bi bi-tv"></i>

                Preview TV

            </a>

        </div>

    </nav>

    <div class="container mt-4">

        <!-- CARD STATISTIK -->
        <div class="row g-4">

            <div class="col-md-3">

                <div class="card shadow border-0">

                    <div class="card-body text-center">

                        <i class="bi bi-calendar-week text-primary fs-1"></i>

                        <h5 class="mt-2">Total Jadwal</h5>

                        <h2 id="totalJadwal"><%= jadwal.length %></h2>

                    </div>

                </div>

            </div>

            <div class="col-md-3">

                <div class="card shadow border-0">

                    <div class="card-body text-center">

                        <i class="bi bi-person-video3 text-success fs-1"></i>

                        <h5 class="mt-2">Dosen</h5>

                        <h2 id="totalDosen">

                            <%= [...new Set(jadwal.map(item=>item.dosen))].length %>

                        </h2>

                    </div>

                </div>

            </div>

            <div class="col-md-3">

                <div class="card shadow border-0">

                    <div class="card-body text-center">

                        <i class="bi bi-building text-warning fs-1"></i>

                        <h5 class="mt-2">Ruangan</h5>

                        <h2 id="totalRuangan">

                            <%= [...new Set(jadwal.map(item=>item.ruangan))].length %>

                        </h2>

                    </div>

                </div>

            </div>

        <div class="col-md-3">

            <div class="card shadow border-0">

                <div class="card-body text-center">

                        <i class="bi bi-mortarboard text-info fs-1"></i>

                        <h5 class="mt-2">Program Studi</h5>

                        <h2 id="totalProdi">

                            <%= [...new Set(jadwal.map(item => item.prodi))].length %>

                        </h2>

                </div>

            </div>

        </div>

        </div>

        <!-- TABEL -->
        <div class="card shadow mt-4">

            <div class="card-header bg-primary text-white">

                <!-- Header -->
                <div class="d-flex justify-content-between align-items-center">

                    <h4 class="mb-0">

                        <i class="bi bi-table"></i>

                        Data Jadwal Perkuliahan

                    </h4>

                    <a href="/admin/tambah" class="btn btn-success">

                        <i class="bi bi-plus-circle"></i>

                        Tambah Jadwal

                    </a>

                </div>

            </div>

            <div class="card-body">
                
                <div class="row mt-3 g-2">

                    <!-- Filter Hari -->
                    <div class="col-md-3">

                        <select id="filterHari" class="form-select">

                            <option value="">📅 Semua Hari</option>

                            <option value="Senin">Senin</option>
                            <option value="Selasa">Selasa</option>
                            <option value="Rabu">Rabu</option>
                            <option value="Kamis">Kamis</option>
                            <option value="Jumat">Jumat</option>
                            <option value="Sabtu">Sabtu</option>
                            <option value="Minggu">Minggu</option>

                        </select>

                    </div>

                    <!-- Filter Ruangan -->
                    <div class="col-md-3">

                        <select id="filterRuangan" class="form-select">

                            <option value="">🏫 Semua Ruangan</option>

                            <% let ruang = [...new Set(jadwal.map(j => j.ruangan))]; %>

                            <% ruang.forEach(function(r){ %>

                                <option value="<%= r %>">

                                    <%= r %>

                                </option>

                            <% }) %>

                        </select>

                    </div>

                    <!-- Filter Prodi -->
                    <div class="col-md-3">

                        <select id="filterProdi" class="form-select">

                            <option value="">🎓 Semua Prodi</option>

                            <% let prodi = [...new Set(jadwal.map(j => j.prodi))]; %>

                            <% prodi.forEach(function(p){ %>

                                <option value="<%= p %>">

                                    <%= p %>

                                </option>

                            <% }) %>

                        </select>

                    </div>

                    <!-- Cari -->
                    <div class="col-md-3">

                        <input

                            type="text"

                            id="searchMatkul"

                            class="form-control"

                            placeholder="🔍 Cari Mata Kuliah..."

                        >

                    </div>

                </div>

                <div class="table-responsive mt-3">

                    <table class="table table-bordered table-hover align-middle">

                        <thead class="table-primary text-center">

                            <tr>

                                <th>No</th>

                                <th>Hari</th>

                                <th>Jam</th>

                                <th>Mata Kuliah</th>

                                <th>Program Studi</th>

                                <th>Dosen</th>

                                <th>Ruangan</th>

                                <th>Status</th>

                                <th width="170">Aksi</th>

                            </tr>

                        </thead>

                        <tbody id="tbodyJadwal">
                            <% if(jadwal.length==0){ %>

                            <tr>

                                <td colspan="9" class="text-center">

                                    Belum ada jadwal.

                                </td>

                            </tr>

                            <% } else { %>

                            <% jadwal.forEach((item,index)=>{ %>

                            <tr class="jadwal-row" 
                                data-hari="<%= item.hari %>" 
                                data-ruangan="<%= item.ruangan %>" 
                                data-prodi="<%= item.prodi || '' %>" 
                                data-matkul="<%= item.matkul %>"
                                data-jam="<%= item.jam %>"
                                data-id="<%= item.id || index %>">

                                <td class="text-center">

                                    <%= index+1 %>

                                </td>

                                <td class="hari">

                                    <%= item.hari %>

                                </td>

                                <td>

                                    <%= item.jamDisplay || item.jam %>

                                </td>

                                <td class="matkul">

                                    <%= item.matkul %>

                                </td>

                                <td class="prodi">

                                    <%= item.prodi || "-" %>

                                </td>

                                <td>

                                    <%= item.dosen %>

                                </td>

                                <td class="ruangan">

                                    <%= item.ruangan %>

                                </td>

                                <td class="text-center status-cell">

                                    <% if(item.status=="Berlangsung"){ %>

                                        <span class="badge bg-success">

                                            🟢 Berlangsung

                                        </span>

                                    <% } else if(item.status=="Belum Mulai"){ %>

                                        <span class="badge bg-warning text-dark">

                                            🟡 Belum Mulai

                                        </span>

                                    <% } else { %>

                                        <span class="badge bg-secondary">

                                            ⚪ Selesai

                                        </span>

                                    <% } %>

                                </td>

                                <td class="text-center">

                                    <a href="/admin/edit/<%= item.id || item.indexAsli %>"
                                       class="btn btn-warning btn-sm">

                                        <i class="bi bi-pencil-square"></i>

                                    </a>

                                    <a href="/admin/hapus/<%= item.id || item.indexAsli %>"
                                       class="btn btn-danger btn-sm"
                                       onclick="return confirm('Yakin ingin menghapus jadwal ini?')">

                                        <i class="bi bi-trash"></i>

                                    </a>

                                </td>

                            </tr>

                            <% }) %>

                            <% } %>

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

    <!-- FOOTER -->
    <footer class="text-center mt-5 mb-3 text-secondary">

        <p>
            <i class="bi bi-clock"></i>
            Waktu Indonesia Tengah (WITA) | Status diperbarui otomatis setiap 60 detik
        </p>
        <p>© 2026 POLITEKNIK DEWANTARA</p>

    </footer>

    <!-- ===================================================== -->
    <!-- 🔥 SCRIPT FILTER (LANGSUNG DI HALAMAN) -->
    <!-- ===================================================== -->
    <script>
        // ======================================
        // FUNGSI FILTER
        // ======================================

        function filterTabel() {
            const filterHari = document.getElementById("filterHari");
            const filterRuangan = document.getElementById("filterRuangan");
            const filterProdi = document.getElementById("filterProdi");
            const searchMatkul = document.getElementById("searchMatkul");

            const hari = filterHari ? filterHari.value.trim().toLowerCase() : "";
            const ruangan = filterRuangan ? filterRuangan.value.trim().toLowerCase() : "";
            const prodi = filterProdi ? filterProdi.value.trim().toLowerCase() : "";
            const keyword = searchMatkul ? searchMatkul.value.trim().toLowerCase() : "";

            const rows = document.querySelectorAll(".jadwal-row");
            let nomor = 1;

            rows.forEach(row => {
                // Ambil data dari atribut data-*
                const dataHari = (row.getAttribute("data-hari") || "").toLowerCase();
                const dataRuangan = (row.getAttribute("data-ruangan") || "").toLowerCase();
                const dataProdi = (row.getAttribute("data-prodi") || "").toLowerCase();
                const dataMatkul = (row.getAttribute("data-matkul") || "").toLowerCase();

                let cocokHari = true;
                let cocokRuangan = true;
                let cocokProdi = true;
                let cocokMatkul = true;

                if (hari) cocokHari = dataHari === hari;
                if (ruangan) cocokRuangan = dataRuangan === ruangan;
                if (prodi) cocokProdi = dataProdi === prodi;
                if (keyword) cocokMatkul = dataMatkul.includes(keyword);

                if (cocokHari && cocokRuangan && cocokProdi && cocokMatkul) {
                    row.style.display = "";
                    // Update nomor urut
                    const tdNo = row.querySelector("td:first-child");
                    if (tdNo) tdNo.textContent = nomor++;
                } else {
                    row.style.display = "none";
                }
            });
        }

        // ======================================
        // EVENT LISTENERS
        // ======================================

        document.addEventListener("DOMContentLoaded", function() {
            console.log("✅ Dashboard Admin siap");

            const filterHari = document.getElementById("filterHari");
            const filterRuangan = document.getElementById("filterRuangan");
            const filterProdi = document.getElementById("filterProdi");
            const searchMatkul = document.getElementById("searchMatkul");

            if (filterHari) filterHari.addEventListener("change", filterTabel);
            if (filterRuangan) filterRuangan.addEventListener("change", filterTabel);
            if (filterProdi) filterProdi.addEventListener("change", filterTabel);
            if (searchMatkul) searchMatkul.addEventListener("keyup", filterTabel);

            // Jalankan pertama kali
            setTimeout(filterTabel, 100);

            // Debug: tampilkan jumlah data
            const rows = document.querySelectorAll(".jadwal-row");
            console.log("📊 Total data:", rows.length);
        });

    </script>

</body>

</html>