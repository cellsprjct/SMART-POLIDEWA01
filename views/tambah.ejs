<!DOCTYPE html>
<html lang="id">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1">

    <title>Tambah Jadwal</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet"
          href="/css/admin.css">

</head>

<body class="bg-light">

<!-- ===========================================
NAVBAR
=========================================== -->

<nav class="navbar navbar-dark bg-primary shadow">

    <div class="container-fluid">

        <h3 class="text-white mb-0">

            <i class="bi bi-plus-circle"></i>

            Tambah Jadwal Perkuliahan

        </h3>

        <a href="/admin"
           class="btn btn-light">

            <i class="bi bi-arrow-left-circle"></i>

            Dashboard

        </a>

    </div>

</nav>

<div class="container mt-5">

<div class="row justify-content-center">

<div class="col-lg-8">

<div class="card shadow border-0">

<div class="card-header bg-primary text-white">

<h4 class="mb-0">

<i class="bi bi-calendar-plus"></i>

Form Tambah Jadwal

</h4>

</div>

<div class="card-body">

<form action="/admin/tambah"

      method="POST">

<!-- ===========================================
HARI
=========================================== -->

<div class="mb-3">

<label class="form-label fw-bold">

Hari

</label>

<select

name="hari"

class="form-select"

required>

<option value="">

-- Pilih Hari --

</option>

<option>Senin</option>

<option>Selasa</option>

<option>Rabu</option>

<option>Kamis</option>

<option>Jumat</option>

<option>Sabtu</option>

</select>

</div>

<!-- ===========================================
JAM
=========================================== -->

<div class="mb-3">

<label class="form-label fw-bold">

Jam

</label>

<input

type="text"

name="jam"

class="form-control"

placeholder="07:30-09:30 atau 07.30-09.30"

required>

<div class="form-text">

Mendukung format titik maupun titik dua.

</div>

</div>

<!-- ===========================================
MATA KULIAH
=========================================== -->

<div class="mb-3">

    <label class="form-label fw-bold">

        Mata Kuliah

    </label>

    <input

        type="text"

        name="matkul"

        class="form-control"

        placeholder="Contoh : Pemrograman Web"

        required

    >

</div>


<!-- ===========================================
PROGRAM STUDI
=========================================== -->

<div class="mb-3">

    <label class="form-label">

        Program Studi

    </label>

    <input
        type="text"
        name="prodi"
        class="form-control"
        placeholder="Masukkan Program Studi"
        required>

</div>


<!-- ===========================================
DOSEN
=========================================== -->

<div class="mb-3">

    <label class="form-label fw-bold">

        Dosen Pengampu

    </label>

    <input

        type="text"

        name="dosen"

        class="form-control"

        placeholder="Masukkan Nama Dosen"

        required

    >

</div>


<!-- ===========================================
RUANGAN
=========================================== -->

<div class="mb-4">

    <label class="form-label fw-bold">

        Ruangan

    </label>

    <input

        type="text"

        name="ruangan"

        class="form-control"

        placeholder="Contoh : LABKOM 1"

        required

    >

</div>


<hr>


<!-- ===========================================
TOMBOL
=========================================== -->

<div class="d-flex justify-content-between">

    <a

        href="/admin"

        class="btn btn-secondary"

    >

        <i class="bi bi-arrow-left-circle"></i>

        Kembali

    </a>

    <div>

        <button

            type="reset"

            class="btn btn-warning"

        >

            <i class="bi bi-arrow-clockwise"></i>

            Reset

        </button>

        <button

            type="submit"

            class="btn btn-success"

        >

            <i class="bi bi-check-circle"></i>

            Simpan Jadwal

        </button>

    </div>

</div>

</form>

</div>

</div>

</div>

</div>

</div>


<!-- ===========================================
FOOTER
=========================================== -->

<footer class="text-center mt-5 mb-4 text-secondary">

<hr>

<p>

TEKNIK ELEKTRONIKA

<br>

© 2026 POLITEKNIK DEWANTARA

</p>

</footer>


<!-- ===========================================
VALIDASI BOOTSTRAP
=========================================== -->

<script>

(() => {

    'use strict';

    const forms = document.querySelectorAll('form');

    Array.from(forms).forEach(form => {

        form.addEventListener('submit', event => {

            if (!form.checkValidity()) {

                event.preventDefault();

                event.stopPropagation();

            }

            form.classList.add('was-validated');

        }, false);

    });

})();

</script>

</body>

</html>